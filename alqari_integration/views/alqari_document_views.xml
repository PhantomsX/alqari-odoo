<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_alqari_document_search" model="ir.ui.view">
        <field name="name">alqari.document.search</field>
        <field name="model">alqari.document</field>
        <field name="arch" type="xml">
            <search string="Al-Qari Documents">
                <field name="name"/>
                <field name="file_name"/>
                <field name="document_id"/>
                <field name="doc_type"/>
                <field name="extracted_invoice_number"/>
                <field name="extracted_vendor"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Processing" name="filter_processing" domain="[('state', '=', 'processing')]"/>
                <filter string="Awaiting Review" name="filter_awaiting_review" domain="[('state', '=', 'awaiting_review')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Error" name="filter_error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Document Type" name="group_doc_type" context="{'group_by': 'doc_type'}"/>
                    <filter string="Created On" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_alqari_document_kanban" model="ir.ui.view">
        <field name="name">alqari.document.kanban</field>
        <field name="model">alqari.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile" quick_create="false">
                <field name="name"/>
                <field name="file_name"/>
                <field name="state"/>
                <field name="doc_type"/>
                <field name="extracted_invoice_number"/>
                <field name="extracted_total"/>
                <field name="extracted_vendor"/>
                <field name="color"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted">
                                        <field name="file_name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.doc_type.value">
                                    <span class="badge text-bg-secondary"><field name="doc_type"/></span>
                                </div>
                                <div t-if="record.extracted_invoice_number.value" class="mt-1">
                                    Invoice: <field name="extracted_invoice_number"/>
                                </div>
                                <div t-if="record.extracted_total.value">
                                    Total: <field name="extracted_total"/>
                                </div>
                                <div t-if="record.extracted_vendor.value" class="text-muted">
                                    <field name="extracted_vendor"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'secondary', 'processing': 'info', 'awaiting_review': 'warning', 'done': 'success', 'error': 'danger'}}"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="create_date" widget="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_alqari_document_tree" model="ir.ui.view">
        <field name="name">alqari.document.tree</field>
        <field name="model">alqari.document</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'done'" decoration-danger="state == 'error'" decoration-warning="state == 'awaiting_review'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="file_name"/>
                <field name="doc_type"/>
                <field name="extracted_invoice_number" optional="show"/>
                <field name="extracted_total" optional="show"/>
                <field name="extracted_vendor" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'processing'"
                       decoration-danger="state == 'error'"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_alqari_document_form" model="ir.ui.view">
        <field name="name">alqari.document.form</field>
        <field name="model">alqari.document</field>
        <field name="arch" type="xml">
            <form string="Al-Qari Document">
                <header>
                    <button name="action_process" type="object" string="Process Document"
                            class="btn-primary" invisible="state in ('processing', 'awaiting_review')"/>
                    <button name="action_check_review_status" type="object" string="Check Review Status"
                            class="btn-secondary" invisible="state != 'awaiting_review'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,processing,awaiting_review,done,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_process"
                                icon="fa-refresh" invisible="state == 'processing' or not attachment_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Re-process</span>
                            </div>
                        </button>
                    </div>
                    <field name="color" invisible="1"/>
                    <field name="validation_json" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Vendor invoice March 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="upload_file" filename="upload_filename"
                                   invisible="state not in ('draft', 'error')"/>
                            <field name="upload_filename" invisible="1"/>
                            <field name="file_name" readonly="1" invisible="not attachment_id"/>
                            <field name="attachment_id" invisible="1"/>
                            <field name="document_id" readonly="1"/>
                            <field name="doc_type" readonly="1"/>
                        </group>
                        <group string="Processing Options">
                            <field name="ocr_language" readonly="state == 'processing'"/>
                            <field name="ocr_output_format" readonly="state == 'processing'"/>
                            <field name="fields_to_extract" readonly="state == 'processing'"/>
                            <field name="run_classify" readonly="state == 'processing'"/>
                            <field name="classify_categories" readonly="state == 'processing'"
                                   invisible="not run_classify"/>
                            <field name="run_validate" readonly="state == 'processing'"/>
                            <field name="validation_required_fields" readonly="state == 'processing'"
                                   invisible="not run_validate"/>
                            <field name="validation_rules" readonly="state == 'processing'"
                                   invisible="not run_validate"/>
                            <field name="run_human_review" readonly="state in ('processing', 'awaiting_review')"/>
                            <field name="human_review_trigger" readonly="state in ('processing', 'awaiting_review')"
                                   invisible="not run_human_review"/>
                            <field name="review_send_email" readonly="state in ('processing', 'awaiting_review')"
                                   invisible="not run_human_review"/>
                            <field name="review_assignee_email" readonly="state in ('processing', 'awaiting_review')"
                                   invisible="not run_human_review or not review_send_email"/>
                            <field name="review_instructions" readonly="state in ('processing', 'awaiting_review')"
                                   invisible="not run_human_review"/>
                            <field name="review_task_id" readonly="1" invisible="not review_task_id"/>
                            <field name="review_status" readonly="1" invisible="not review_status"/>
                            <field name="review_email_sent" readonly="1"
                                   invisible="not run_human_review or not review_send_email"/>
                        </group>
                    </group>
                    <group string="Extracted Summary" invisible="state != 'done'">
                        <group>
                            <field name="extracted_invoice_number" readonly="1"/>
                            <field name="extracted_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="extracted_total" readonly="1"/>
                            <field name="extracted_vendor" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extracted Fields" invisible="state != 'done'">
                            <field name="fields_summary_html" nolabel="1"/>
                        </page>
                        <page string="OCR Text">
                            <field name="ocr_text" nolabel="1" readonly="1"
                                   placeholder="OCR text will appear here after processing."/>
                        </page>
                        <page string="Raw JSON" groups="base.group_no_one">
                            <group>
                                <field name="extracted_fields_json" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                        <page string="Validation" invisible="not validation_json">
                            <field name="validation_passed" invisible="1"/>
                            <field name="validation_summary" readonly="1"/>
                            <field name="validation_summary_html" nolabel="1"/>
                            <group string="Raw JSON" groups="base.group_no_one">
                                <field name="validation_json" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                        <page string="Human Review" invisible="not review_task_id">
                            <group>
                                <field name="review_task_id" readonly="1"/>
                                <field name="review_status" readonly="1"/>
                                <field name="review_assignee_email" readonly="1"/>
                                <field name="review_email_sent" readonly="1"/>
                                <field name="review_instructions" readonly="1"/>
                            </group>
                        </page>
                        <page string="Error Details" invisible="state != 'error'">
                            <field name="error_message" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_alqari_documents" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">alqari.document</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_alqari_document_search"/>
        <field name="context">{'search_default_filter_done': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Process your first document with Al-Qari
            </p>
            <p>
                Upload a PDF to run OCR and extract structured fields such as invoice numbers, totals, and dates.
            </p>
        </field>
    </record>
</odoo>
