<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_alqari" model="ir.module.category">
        <field name="name">Al-Qari</field>
        <field name="description">Document AI integration</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_alqari_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_alqari"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_alqari_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_alqari"/>
        <field name="implied_ids" eval="[(4, ref('group_alqari_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- All internal Odoo users can process documents by default. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_alqari_user'))]"/>
    </record>
</odoo>
